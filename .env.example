# ==============================================================================
# Yami Learning Companion (芽米学习伙伴) — Environment Configuration Template
# Copy to `.env` and fill in your own keys: `cp .env.example .env`
# NEVER commit `.env` to Git!
# ==============================================================================

# --- 1. Database (SQLite by default; uncomment PostgreSQL for Docker/Prod) ---
YAMI_DATABASE_URL=sqlite:///./yami_dev.db
# YAMI_DATABASE_URL=postgresql+psycopg2://yami:yami_dev_password@127.0.0.1:5432/yami

# --- 2. Multi-Tenant Auth JWT Secret (change to a random 32+ char string in prod) ---
YAMI_JWT_SECRET=change-me-to-a-long-random-secret-key

# --- 3. LLM Provider Routing: auto | volc_plan | doubao_seed | deepseek ---
YAMI_AGENT_PROVIDER=auto

# Volcengine Ark (Doubao Seed 2.0 / 2.1 Multimodal — Vision OCR + Voice Companion)
YAMI_ARK_API_KEY=
YAMI_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
YAMI_ARK_SEED_MODEL=doubao-seed-2.1

# Optional: Volcengine Coding/Agent Plan (OpenAI-compatible multimodal)
YAMI_VOLC_PLAN_API_KEY=
YAMI_VOLC_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
YAMI_VOLC_PLAN_MODEL=doubao-seed-2.1-pro

# DeepSeek Fallback (Text Reasoning & Dialogue)
YAMI_DEEPSEEK_API_KEY=
YAMI_DEEPSEEK_BASE_URL=https://api.deepseek.com
YAMI_DEEPSEEK_CHAT_MODEL=deepseek-chat

# --- 4. Real-Time TTS (Tencent Cloud TTS; falls back to macOS `say` locally if empty) ---
YAMI_TENCENT_APP_ID=0
YAMI_TENCENT_SECRET_ID=
YAMI_TENCENT_SECRET_KEY=
YAMI_TENCENT_TTS_VOICE_TYPE=101001

# --- 5. Optional: Neo4j 5 + Graphiti Long-Term Memory (via docker-compose.yml) ---
YAMI_NEO4J_URI=bolt://127.0.0.1:7687
YAMI_NEO4J_USER=neo4j
YAMI_NEO4J_PASSWORD=yami_dev_password

# --- 6. Optional: DingTalk Stream Mode Bot (or configure directly in Guardian Web -> 设置) ---
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
YAMI_FAMILY_ID=fam_a
